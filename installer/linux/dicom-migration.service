[Unit]
Description=DICOM Migration Server
Documentation=https://github.com/jeffthci/dicommigrationserver
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify because Program.cs calls UseSystemd(), which signals READY=1 via sd_notify
# once the host has started. Using Type=simple here would make systemd report the unit
# active before Kestrel is actually listening.
Type=notify
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/DicomMigration
Environment=DOTNET_ENVIRONMENT=Production
# .NET writes diagnostic files to $HOME; the service user has no home directory.
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5
# No KillSignal override: systemd's default SIGTERM is what .NET's systemd host lifetime acts on.
# This unit previously set KillSignal=SIGINT, and the process then died immediately with no
# graceful shutdown at all -- verified by the absence of any "Application is shutting down" entry
# in the journal, and a `systemctl stop` that returned in 0s while a phase was mid-run. That is
# precisely how studies ended up stranded in move_pending.
# A long-running C-MOVE may still be in flight, so allow time to unwind before SIGKILL.
TimeoutStopSec=60
SyslogIdentifier=dicom-migration

# Hardening. The app needs to write only its own data/ and logs/ subdirectories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Only data/ and logs/ need to be writable. Granting the whole install directory let the service
# rewrite its own executable, which turns any code-execution bug into persistence.
# '-' prefixed so a missing directory is tolerated rather than refusing to start the unit
# outright. The installer creates both, but a hand-deleted logs/ should not brick the service.
ReadWritePaths=-@INSTALL_DIR@/data -@INSTALL_DIR@/logs

[Install]
WantedBy=multi-user.target
