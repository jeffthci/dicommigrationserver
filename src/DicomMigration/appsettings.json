{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Dicom": {
    "LocalAeTitle": "MIGRATE",
    "Source": {
      "AeTitle": "SOURCE_PACS",
      "Host": "127.0.0.1",
      "Port": 104
    },
    "Destination": {
      "AeTitle": "DEST_PACS",
      "Host": "127.0.0.1",
      "Port": 104
    },
    "Move": {
      "MaxParallelMoves": 1,
      "AssociationTimeoutSeconds": 60,
      "MoveTimeoutMinutes": 120,
      "MaxAttempts": 2,
      "DelayBetweenMovesMs": 0
    },
    "Verify": {
      "Level": "Study"
    },
    "Inventory": {
      "FetchSeriesCounts": false
    }
  },
  "Database": {
    "Path": "data/migration.db"
  },
  "AllowedHosts": "*"
}
